 /kaggle/working/correlation_analysis\n"]}],"source":["import matplotlib.pyplot as plt\n","import numpy as np\n","import pandas as pd\n","import re\n","import seaborn as sns\n","from scipy import stats\n","from pathlib import Path\n","\n","plt.style.use('seaborn-v0_8-whitegrid')\n","plt.rcParams['font.size'] = 11\n","plt.rcParams['figure.figsize'] = (10, 6)\n","\n","OUTPUT_DIR = Path('/kaggle/working/correlation_analysis')\n","OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n","\n","vicon_df = pd.read_excel('/kaggle/working/signals_vicon/features/vicon_gait_features.xlsx')\n","acc_df = pd.read_excel('/kaggle/working/signals_acc/features/acc_gait_features.xlsx')\n","print(f'  Vicon: {vicon_df.shape}, Acc: {acc_df.shape}')\n","\n","\n","def parse_vicon_filename(filename):\n","    \"\"\"Vicon: 'Afonina_1_center' -> subject_trial='Afonina_1', marker='center'\"\"\"\n","    m = re.match(r'([A-Za-z]+)_(\\d+)_([A-Za-z]+)', str(filename))\n","    if m:\n","        subj, trial, marker = m.groups()\n","        return f'{subj}_{trial}', marker\n","    return None, None\n","\n","\n","def parse_acc_filename(filename):\n","    \"\"\"Acc: 'AfoninaA_1' -> 'Afonina_1' (убираем лишнюю букву в фамилии)\"\"\"\n","    filename = str(filename)\n","    for base in ['Afonina', 'Nikolaenko', 'Derevesnikova']:\n","        if base in filename:\n","            m_num = re.search(r'_(\\d+)', filename)\n","            if m_num:\n","                return f'{base}_{m_num.group(1)}'\n","    return filename\n","\n","vicon_df['match_key'], vicon_df['marker'] = zip(*vicon_df['file_name'].apply(parse_vicon_filename))\n","acc_df['match_key'] = acc_df['file_name'].apply(parse_acc_filename)\n","\n","print(f\"\\nМаркеры в Vicon: {vicon_df['marker'].unique()}\")\n","print(f\"Уникальных сессий в Acc: {acc_df['match_key'].nunique()}\")\n","\n","MARKERS = ['center', 'LASI', 'RASI']\n","\n","EXCLUDE_COLS = [\n","    'group_vicon', 'file_name_vicon', 'match_key', 'marker',\n","    'group_acc', 'file_name_acc',\n","]\n","\n","def analyze_marker(marker_name, vicon_df, acc_df, output_dir):\n","\n","    print(f\"АНАЛИЗ ДЛЯ МАРКЕРА: {marker_name}\")\n","\n","    vicon_marker = vicon_df[vicon_df['marker'] == marker_name].copy()\n","    print(f\"Строк Vicon для маркера {marker_name}: {len(vicon_marker)}\")\n","\n","    merged_df = pd.merge(\n","        vicon_marker,\n","        acc_df,\n","        on='match_key',\n","        suffixes=('_vicon', '_acc'),\n","        how='inner',\n","    )\n","    print(f\"Успешно объединено строк: {len(merged_df)}\")\n","\n","    if len(merged_df) == 0:\n","        print(f\"ОШИБКА: нет пересечений для маркера {marker_name}\")\n","        return None\n","\n","    features = [\n","        c.replace('_vicon', '')\n","        for c in merged_df.columns\n","        if c.endswith('_vicon') and c not in EXCLUDE_COLS\n","    ]\n","    print(f\"Признаков для анализа: {len(features)}\")\n","\n","    results = []\n","    for feat in features:\n","        col_v = f'{feat}_vicon'\n","        col_a = f'{feat}_acc'\n","\n","        if col_v in merged_df.columns and col_a in merged_df.columns:\n","\n","            merged_df[col_v] = pd.to_numeric(merged_df[col_v], errors='coerce')\n","            merged_df[col_a] = pd.to_numeric(merged_df[col_a], errors='coerce')\n","\n","            valid_data = merged_df[[col_v, col_a]].dropna()\n","            if len(valid_data) > 3:\n","                p_corr, p_val = stats.pearsonr(valid_data[col_v], valid_data[col_a])\n","                s_corr, s_val = stats.spearmanr(valid_data[col_v], valid_data[col_a])\n","\n","                v_vals = valid_data[col_v].values\n","                a_vals = valid_data[col_a].values\n","                mean_diff = np.mean(v_vals - a_vals)\n","                std_diff = np.std(v_vals - a_vals, ddof=1)\n","\n","                results.append({\n","                    'Feature': feat,\n","                    'Pearson_r': p_corr,\n","                    'Pearson_p': p_val,\n","                    'Spearman_rho': s_corr,\n","                    'Spearman_p': s_val,\n","                    'Mean_Diff': mean_diff,\n","                    'Std_Diff': std_diff,\n","                })\n","            else:\n","                results.append({\n","                    'Feature': feat,\n","                    'Pearson_r': np.nan, 'Pearson_p': np.nan,\n","                    'Spearman_rho': np.nan, 'Spearman_p': np.nan,\n","                    'Mean_Diff': np.nan, 'Std_Diff': np.nan,\n","                })\n","\n","    res_df = pd.DataFrame(results).dropna(subset=['Pearson_r']).sort_values(\n","        by='Pearson_r', ascending=False\n","    )\n","\n","    print(f'\\n--- ТОП-10 признаков по корреляции Пирсона (маркер {marker_name}) ---')\n","    print(res_df[['Feature', 'Pearson_r', 'Spearman_rho']].head(10))\n","\n","    # Сохраняем таблицу корреляций\n","    corr_path = output_dir / f'correlation_{marker_name}.xlsx'\n","    res_df.to_excel(corr_path, index=False)\n","    print(f\"Таблица сохранена: {corr_path}\")\n","\n","    # 5. Выделение пригодных и непригодных признаков\n","    good_features = res_df[res_df['Pearson_r'] >= 0.6]['Feature'].tolist()\n","    poor_features = res_df[res_df['Pearson_r'] < 0.4]['Feature'].tolist()\n","    print(f'\\nПригодные (r >= 0.6): {len(good_features)}')\n","    print(f'Непригодные (r < 0.4): {len(poor_features)}')\n","\n","    # 6. Heatmap корреляций\n","    diag_corr = res_df.set_index('Feature')[['Pearson_r']]\n","    plt.figure(figsize=(6, max(8, len(res_df) * 0.35)))\n","    sns.heatmap(\n","        diag_corr,\n","        annot=True,\n","        cmap='coolwarm',\n","        vmin=-1, vmax=1,\n","        cbar_kws={'label': 'Pearson r'},\n","    )\n","    plt.title(\n","        f'Согласованность Vicon vs Smartphone\\nМаркер: {marker_name}',\n","        fontsize=14, pad=15,\n","    )\n","    plt.ylabel('Признак походки')\n","    plt.tight_layout()\n","    heatmap_path = output_dir / f'heatmap_{marker_name}.png'\n","    plt.savefig(heatmap_path, dpi=300)\n","    plt.show()\n","    plt.close()\n","    print(f\"Heatmap сохранен: {heatmap_path}\")\n","\n","    # 7. Bland-Altman для топ-3 признаков\n","    top_features = res_df['Feature'].head(3).tolist()\n","    for feat in top_features:\n","        v = merged_df[f'{feat}_vicon'].values\n","        a = merged_df[f'{feat}_acc'].values\n","\n","        mean_va = (v + a) / 2\n","        diff_va = v - a\n","        md = np.mean(diff_va)\n","        sd = np.std(diff_va, ddof=1)\n","\n","        plt.figure(figsize=(8, 5))\n","        plt.scatter(mean_va, diff_va, color='teal', alpha=0.8, edgecolor='k')\n","        plt.axhline(md, color='red', linestyle='--', label=f'Mean Diff: {md:.2f}')\n","        plt.axhline(md + 1.96 * sd, color='gray', linestyle=':',\n","                    label=f'+1.96 SD: {md + 1.96 * sd:.2f}')\n","        plt.axhline(md - 1.96 * sd, color='gray', linestyle=':',\n","                    label=f'-1.96 SD: {md - 1.96 * sd:.2f}')\n","        plt.title(f'Bland-Altman: {feat} (маркер {marker_name})', fontsize=14)\n","        plt.xlabel('Среднее (Vicon + Acc) / 2')\n","        plt.ylabel('Разница (Vicon - Acc)')\n","        plt.legend(loc='upper right')\n","        plt.tight_layout()\n","        ba_path = output_dir / f'bland_altman_{marker_name}_{feat}.png'\n","        plt.savefig(ba_path, dpi=300)\n","        plt.show()\n","        plt.close()\n","\n","    print(f\"Bland-Altman графики для топ-3 сохранены в {output_dir}\")\n","    return res_df\n","\n","\n","# 8. Запуск анализа для каждой точки отдельно\n","all_results = {}\n","for marker in MARKERS:\n","    result = analyze_marker(marker, vicon_df, acc_df, OUTPUT_DIR)\n","    if result is not None:\n","        all_results[marker] = result\n","\n","# 9. Итоговая сводка\n","print(\"\\n\" + \"=\"*70)\n","print(\"ИТОГОВАЯ СВОДКА ПО МАРКЕРАМ\")\n","print(\"=\"*70)\n","for marker, df_res in all_results.items():\n","    good = len(df_res[df_res['Pearson_r'] >= 0.6])\n","    poor = len(df_res[df_res['Pearson_r'] < 0.4])\n","    print(f\"Маркер {marker:7s}: всего признаков {len(df_res):2d} | \"\n","          f\"пригодных (r>=0.6): {good:2d} | непригодных (r<0.4): {poor:2d}\")\n","\n","print(f\"\\nВсе результаты сохранены в: {OUTPUT_DIR}\")"]},{"cell_type":"markdown","id":"905ee764","metadata":{"papermill":{"duration":0.023697,"end_time":"2026-10-24T12:29:29.274033+00:00","exception":false,"start_time":"2026-10-24T12:29:29.250336+00:00","status":"completed"},"tags":[]},"source":["## ЧАСТЬ 3: Совместные графики сигналов Vicon и акселерометра после обрезки"]},{"cell_type":"code","execution_count":13,"id":"7be16790","metadata":{"execution":{"iopub.execute_input":"2026-10-24T12:29:29.322943Z","iopub.status.busy":"2026-10-24T12:29:29.32236Z","iopub.status.idle":"2026-10-24T12:30:20.283724Z","shell.execute_reply":"2026-10-24T12:30:20.282419Z"},"papermill":{"duration":50.988787,"end_time":"2026-10-24T12:30:20.285925+00:00","exception":false,"start_time":"2026-10-24T12:29:29.297138+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","======================================================================\n","Группа: acc_Afonina -> ampl_Afonina | файлов ACC: 5\n","======================================================================\n","  ✓ AfoninaA_1  |  Vicon: 12482 pts, Acc: 12473 pts  |  T=124.8s  →  сигналы + график сохранены\n","  ✓ AfoninaA_2  |  Vicon: 11698 pts, Acc: 11693 pts  |  T=117.0s  →  сигналы + график сохранены\n","  ✓ AfoninaA_3  |  Vicon: 13748 pts, Acc: 13706 pts  |  T=137.5s  →  сигналы + график сохранены\n","  ✓ AfoninaA_4  |  Vicon: 13070 pts, Acc: 13070 pts  |  T=130.7s  →  сигналы + график сохранены\n","  ✓ AfoninaA_5  |  Vicon: 12621 pts, Acc: 12601 pts  |  T=126.2s  →  сигналы + график сохранены\n","\n","======================================================================\n","Группа: acc_Derevesnikova -> ampl_Derevesnikova | файлов ACC: 5\n","==================================