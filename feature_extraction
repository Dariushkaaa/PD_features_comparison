пка для сигналов\n","OUTPUT_PLOTS.mkdir(parents=True, exist_ok=True)\n","OUTPUT_SIGNALS.mkdir(parents=True, exist_ok=True)\n","\n","# Сопоставление групп\n","ACC_TO_VICON_GROUP = {\n","    \"acc_Afonina\": \"ampl_Afonina\",\n","    \"acc_Derevesnikova\": \"ampl_Derevesnikova\",\n","    \"acc_Nikolaenko\": \"ampl_Nikolaenko\"\n","}\n","\n","# Сопоставление имён файлов: Acc -> Vicon\n","def acc_to_vicon_filename(acc_stem: str) -> str:\n","    \"\"\"\n","    Преобразует имя файла акселерометра в имя файла Vicon.\n","    Например: 'AfoninaA_1' -> 'Afonina_1'\n","    \"\"\"\n","    return (acc_stem\n","            .replace(\"DerevesnikovaD\", \"Derevesnikova\")\n","            .replace(\"NikolaenkoD\", \"Nikolaenko\")\n","            .replace(\"AfoninaA\", \"Afonina\"))\n","\n","# Извлечение magnitude\n","def get_magnitude(df):\n","    if \"magnitude\" in df.columns:\n","        return df[\"magnitude\"].values\n","    if all(c in df.columns for c in [\"X\", \"Y\", \"Z\"]):\n","        return np.sqrt(df[\"X\"]**2 + df[\"Y\"]**2 + df[\"Z\"]**2)\n","    return None\n","\n","# Список сессий (по акселерометру — он полный, 5 сессий на каждого)\n","ACC_GROUPS = [\"acc_Afonina\", \"acc_Derevesnikova\", \"acc_Nikolaenko\"]\n","\n","total_saved = 0\n","total_skipped = 0\n","\n","for acc_group in ACC_GROUPS:\n","    vicon_group = ACC_TO_VICON_GROUP[acc_group]\n","    \n","    # === ВАЖНО: используем filtered_data ===\n","    acc_filtered_dir = OUTPUT_BASE_ACC / acc_group / \"filtered_data\"\n","    vicon_filtered_dir = OUTPUT_BASE_VICON / vicon_group / \"filtered_data\"\n","    \n","    if not acc_filtered_dir.exists():\n","        print(f\"  Папка ACC не найдена: {acc_filtered_dir}\")\n","        continue\n","    if not vicon_filtered_dir.exists():\n","        print(f\"  Папка Vicon не найдена: {vicon_filtered_dir}\")\n","        continue\n","    \n","    # Файлы в filtered_data имеют суффикс _filtered.xlsx\n","    acc_files = sorted([f for f in acc_filtered_dir.glob(\"*_filtered.