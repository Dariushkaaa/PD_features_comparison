():\n","        df_gyro = pd.read_csv(gyro_path)\n","        df_gyro.index = pd.to_datetime(df_gyro['time'], unit='ns')\n","        gyro_col = 'z' if 'z' in df_gyro.columns else 'zUncalib'\n","        df_gyro['yaw'] = np.cumsum(df_gyro[gyro_col].values * (1.0 / FS))\n","        df = pd.merge_asof(df_acc, df_gyro[['yaw']], left_index=True, right_index=True, direction='nearest')\n","    else:\n","        df = df_acc.copy()\n","        df['yaw'] = 0.0\n","        \n","    df['time_sec'] = (df.index - df.index[0]).total_seconds()\n","    result_df = df[['time_sec', 'X', 'Y', 'Z', 'magnitude', 'yaw']].copy()\n","    result_df.rename(columns={'time_sec': 'time'}, inplace=True)\n","    return result_df\n","\n","def save_to_excel(df, output_path: Path):\n","    try:\n","        writer = pd.ExcelWriter(output_path, engine='xlsxwriter')\n","        df.to_excel(writer, sheet_name='Sheet1', index=False)\n","        workbook = writer.book\n","        worksheet = writer.sheets['Sheet1']\n","        number_format = workbook.add_format({'num_format': '0.0000000'})\n","        for col_num in range(len(df.columns)):\n","            worksheet.set_column(col_num, col_num, 18, number_format)\n","        writer.close()\n","        print(f\"  Сохранено: {output_path.name} ({len(df)} строк)\")\n","    except Exception:\n","        df.to_excel(output_path, index=False)\n","        print(f\"  Сохранено: {output_path.name} ({len(df)} строк)\")\n","\n","total_files = 0\n","total_success = 0\n","\n","for group in GROUPS:\n","    group_base = BASE_PATH_ACC / group\n","    possible_inner = group_base / group\n","    target_dir = possible_inner if possible_inner.exists() else group_base\n","    \n","    if not target_dir.exists():\n","        print(f\"Папка не найдена: {target_dir}\")\n","        continue\n","        \n","    session_folders = [d for d in target_dir.iterdir() if d.is_dir()]\n","    if not session_folders:\n","        print(f\"Папки сессий не найдены в: {target_dir}\")\n","        continue\n","        \n","    print(f\"\\nГруппа {group}: {len(session_folders)} сессий\")\n","    print(f\"Вход: {target_dir}\")\n","    print(f\"Выход: {OUTPUT_BASE_ACC / group / OUTPUT_FOLDER}\")\n","    \n","    for session_path in sorted(session_folders):\n","        output_path = OUTPUT_BASE_ACC / group / OUTPUT_FOLDER\n","        output_path.mkdir(parents=True, exist_ok=True)\n","        output_file = output_path / f\"{session_path.name}.xlsx\"\n","        try:\n","            df = load_acc_data(session_path)\n","            save_to_excel(df, output_file)\n","            total_success += 1\n","        except Exception as e:\n","            print(f\"  Ошибка {session_path.name}: {e}\")\n","        total_files += 1\n","\n","print(f\"\\nОбработано сессий: {total_success}/{total_files} файлов\")"]},{"cell_type":"markdown","id":"e5680de3","metadata":{"papermill":{"duration":0.01262,"end_time":"2026-10-24T12:21:35.064412+00:00","exception":false,"start_time":"2026-10-24T12:21:35.051792+00:00","status":"completed"},"tags":[]},"source":["## ШАГ 3 Поиск пика прыжка и синхронизация по длительности с Vicon"]},{"cell_type":"code","execution_count":9,"id":"21d13d22","metadata":{"execution":{"iopub.execute_input":"2026-10-24T12:21:35.091558Z","iopub.status.busy":"2026-10-24T12:21:35.091242Z","iopub.status.idle":"2026-10-24T12:22:29.313287Z","shell.execute_reply":"2026-10-24T12:22:29.311942Z"},"papermill":{"duration":54.238763,"end_time":"2026-10-24T12:22:29.315541+00:00","exception":false,"start_time":"2026-10-24T12:21:35.076778+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Группа acc_Afonina: 5 файлов\n","  Найден пик прыжка: t=16.940 с, magnitude=45.4 (индекс 1694)\n","  Начало записи: t=18.440 с (индекс 1844)\n","  Обрезка конца: удалено 7.830 с (783 строк).\n","  ✓ Сохранено: AfoninaA_1.xlsx (12473 строк, было 15100)\n","\n","  Найден пик прыжка: t=10.500 с, magnitude=33.5 (индекс 1050)\n","  Начало записи: t=12.000