   return {axis: min_max_normalize(sig) for axis, sig in axes_dict.items()}\n","\n","def estimate_step_distance(signal):\n","    signal = signal - np.mean(signal)\n","    corr = correlate(signal, signal, mode=\"full\")\n","    corr = corr[len(corr) // 2:]\n","    min_lag, max_lag = int(FS * 0.3), int(FS * 1.2)\n","    corr_range = corr[min_lag:max_lag]\n","    if len(corr_range) == 0:\n","        return int(FS * 0.5)\n","    return np.argmax(corr_range) + min_lag\n","\n","def detect_peaks_advanced(signal):\n","    step_dist = estimate_step_distance(signal)\n","    height = np.percentile(signal, 70)\n","    peaks, _ = find_peaks(signal, distance=int(step_dist * 0.45), height=height, prominence=np.std(signal) * 0.45)\n","    return peaks\n","\n","def detect_troughs_advanced(signal):\n","    step_dist = estimate_step_distance(-signal)\n","    height = np.percentile(-signal, 70)\n","    troughs, _ = find_peaks(-signal, distance=int(step_dist * 0.45), height=height, prominence=np.std(-signal) * 0.3)\n","    return troughs\n","\n","def detect_peaks_and_troughs_all_axes(norm_signals, fs=100):\n","    results = {}\n","    for axis, signal in norm_signals.items():\n","        results[axis] = {\n","            \"peaks\": detect_peaks_advanced(signal),\n","            \"troughs\": detect_troughs_advanced(signal),\n","        }\n","    return results\n","\n","def plot_all_axes_with_peaks_troughs(time, raw, filtered, normalized, peaks_troughs, save_path, title):\n","    axes = [\"X\", \"Y\", \"Z\", \"magnitude\"]\n","    plt.figure(figsize=(16, 14))\n","    for i, axis in enumerate(axes):\n","        pt = peaks_troughs.get(axis, {\"peaks\": [], \"troughs\": []})\n","        peaks, troughs = pt[\"peaks\"], pt[\"troughs\"]\n","        \n","        plt.subplot(len(axes), 3, i * 3 + 1)\n","        plt.plot(time, raw[axis], alpha=0.5, color=\"gray\")\n","        plt.title(f\"{axis} (raw)\")\n","        plt.grid(alpha=0.3)\n","        \n","        plt.subplot(len(axes), 3, i * 3 + 2)\n","        plt.plot(time, filtered[axis], color=\"blue\")\n","        if len(peaks) > 0:\n","            valid = peaks[peaks < len(time)]\n","            plt.scatter(time[valid], filtered[axis][valid], color=\"red\", marker=\"^\", s=30)\n","        if len(troughs) > 0:\n","            valid = troughs[troughs < len(time)]\n","            plt.scatter(time[valid], filtered[axis][valid], color=\"blue\", marker=\"v\", s=30)\n","        plt.title(f\"{axis} (filtered)\")\n","        plt.grid(alpha=0.3)\n","        \n","        mid_idx = len(time) // 2\n","        window_seconds = 7.0\n","        start_time = max(0, time[mid_idx] - window_seconds / 2)\n","        end_time = min(time[-1], time[mid_idx] + window_seconds / 2)\n","        start_idx = np.searchsorted(time, start_time)\n","        end_idx = np.searchsorted(time, end_time)\n","        \n","        time_zoom = time[start_idx:end_idx]\n","        normalized_zoom = normalized[axis][start_idx:end_idx]\n","        \n","        plt.subplot(len(axes), 3, i * 3 + 3)\n","        plt.plot(time_zoom, normalized_zoom, color=\"green\", linewidth=0.5)\n","        if len(peaks) > 0:\n","            vp = peaks[(peaks >= start_idx) & (peaks < end_idx)]\n","            if len(vp) > 0:\n","                plt.scatter(time[vp], normalized[axis][vp], color=\"red\", marker=\"^\", s=50)\n","        if len(troughs) > 0:\n","            vt = troughs[(troughs >= start_idx) & (troughs < end_idx)]\n","            if len(vt) > 0:\n","                plt.scatter(time[vt], normalized[axis][vt], color=\"blue\", marker=\"v\", s=50)\n","        plt.title(f\"{axis} (zoom)\")\n","        plt.grid(alpha=0.3)\n","        \n","    plt.suptitle(title, fontsize=14)\n","    plt.tight_layout()\n","    save_path.parent.mkdir(parents=True, exist_ok=True)\n","    plt.savefig(save_path, dpi=100)\n","    plt.close()\n","\n","def save_peaks_troughs_excel(time, signals, peaks_troughs, seg_name, writer):\n","    axes = [\"X\", \"Y\", \"Z\", \"magnitude\"]\n","    saved = False\n","    for axis in axes:\n","        pt = peaks_troughs.get(axis, {\"peaks\": [], \"troughs\": []})\n","        all_extrema = []\n","        for idx in pt[\"peaks\"]:\n","            if idx < len(time):\n","                all_extrema.append({\"time\": time[idx], \"amplitude\": signals[axis][idx], \"index\": int(idx), \"type\": \"peak\"})\n","        for idx in pt[\"troughs\"]:\n","            if idx < len(time):\n","                all_extrema.append({\"time\": time[idx], \"amplitude\": signals[axis][idx], \"index\": int(idx), \"type\": \"trough\"})\n","        if all_extrema:\n","            df = pd.DataFrame(all_extrema).sort_values(\"time\").reset_index(drop=True)\n","            short_seg = seg_name.replace(\"segment_\", \"seg\")\n","            sheet_name = f\"{short_seg}_{axis}\"[:31]\n","            try:\n","                df.to_excel(writer, sheet_name=sheet_name, index=False)\n","                saved = True\n","            except Exception:\n","                pass\n","    return saved\n","\n","def process_excel(excel_path, group):\n","    base_name = excel_path.stem\n","    peaks_plot_dir = OUTPUT_BASE_ACC / group / \"peaks_plots\"\n","    peaks_data_dir = OUTPUT_BASE_ACC / group / \"peaks_data\"\n","    filtered_dir = OUTPUT_BASE_ACC / group / \"filtered_data\"\n","    \n","    peaks_plot_dir.mkdir(parents=True, exist_ok=True)\n","    peaks_data_dir.mkdir(parents=True, exist_ok=True)\n","    filtered_dir.mkdir(parents=True, exist_ok=True)\n","    \n","    peaks_excel_path = peaks_data_dir / f\"{base_name}_peaks.xlsx\"\n","    filtered_excel_path = filtered_dir / f\"{base_name}_filtered.xlsx\"\n","    \n","    try:\n","        df = pd.read_excel(excel_path, sheet_name=\"Sheet1\")\n","    except Exception as e:\n","        print(f\"Ошибка чтения {excel_path.name}: {e}\")\n","        return\n","    if df.empty or \"time\" not in df.columns:\n","        return\n","    if \"magnitude\" not in df.columns and all(c in df.columns for c in [\"X\", \"Y\", \"Z\"]):\n","        df[\"magnitude\"] = np.sqrt(df[\"X\"]**2 + df[\"Y\"]**2 + df[\"Z\"]**2)\n","        \n","    time = df[\"time\"].values\n","    raw_seg = {axis: df[axis].values for axis in [\"X\", \"Y\", \"Z\", \"magnitude\"] if axis in df.columns}\n","    \n","    filt_seg_for_peaks = {axis: bandpass_filter(raw_seg[axis], PEAKS_LOWCUT, PEAKS_HIGHCUT, PEAKS_ORDER) for axis in raw_seg}\n","    norm_seg_for_peaks = normalize_axes(filt_seg_for_peaks)\n","    \n","    filt_seg_for_save = {axis: bandpass_filter(raw_seg[axis], SAVE_LOWCUT, SAVE_HIGHCUT, SAVE_ORDER) for axis in raw_seg}\n","    norm_seg_for_save = normalize_axes(filt_seg_for_save)\n","    \n","    peaks_troughs = detect_peaks_and_troughs_all_axes(norm_seg_for_peaks, fs=FS)\n","    plot_path = peaks_plot_dir / f\"{base_name}.png\"\n","    plot_all_axes_with_peaks_troughs(time, raw_seg, filt_seg_for_save, norm_seg_for_save, peaks_troughs, plot_path, base_name)\n","    \n","    with pd.ExcelWriter(peaks_excel_path, engine=\"openpyxl\") as peak_writer, pd.ExcelWriter(filtered_excel_path, engine=\"openpyxl\") as filt_writer:\n","        saved_any = save_peaks_troughs_excel(time, norm_seg_for_save, peaks_troughs, base_name, peak_writer)\n","        out_df = pd.DataFrame({\"time\": time, \"X\": norm_seg_for_save[\"X\"], \"Y\": norm_seg_for_save[\"Y\"], \"Z\": norm_seg_for_save[\"Z\"], \"magnitude\": norm_seg_for_save[\"magnitude\"]})\n","        out_df.to_excel(filt_writer, sheet_name=\"Sheet1\", index=False)\n","        if not saved_any:\n","            peaks_excel_path.unlink(missing_ok=True)\n","    print(f\"  ✓ Обработан: {base_name}\")\n","\n","for group in GROUPS:\n","    input_path = OUTPUT_BASE_ACC / group / INPUT_FOLDER\n","    if not input_path.exists(): continue\n","    xlsx_files = [f for f in input_path.glob(\"*.xlsx\") if not f.name.startswith(\"~$\")]\n","    print(f\"\\nГруппа {group} / {INPUT_FOLDER} — файлов: {len(xlsx_files)}\")\n","    for excel_path in sorted(xlsx_files):\n","        process_excel(excel_path, group)\n","\n","print(\"Фильтрация акселерометра завершена.\")"]},{"cell_type":"markdown","id":"9df98832","metadata":{"papermill":{"duration":0.013723,"end_time":"2026-10-24T12:23:32.747152+00:00","exception":false,"start_time":"2026-10-24T12:23:32.733429+00:00","status":"completed"},"tags":[]},"source":["## ШАГ 5: Расчет признаков акселерометра"]},{"cell_type":"code","execution_count":11,"id":"a20aaead","metadata":{"execution":{"iopub.execute_input":"2026-10-24T12:23:32.775641Z","iopub.status.busy":"2026-10-24T12:23:32.775327Z","iopub.status.idle":"2026-10-24T12:29:19.45782Z","shell.execute_reply":"2026-10-24T12:29:19.456446Z"},"papermill":{"duration":346.699417,"end_time":"2026-10-24T12:29:19.45985+00:00","exception":false,"start_time":"2026-10-24T12:23:32.760433+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Запуск извлечения признаков акселерометра...\n","\n","Группа acc_Afonina: найдено 5 файлов\n","  ✓ Обработан: AfoninaA_2\n","  ✓ Обработан: AfoninaA_3\n","  ✓ Обработан: AfoninaA_4\n","  ✓ Обработан: AfoninaA_5\n","  ✓ Обработан: AfoninaA_1\n","\n","Группа acc_Derevesnikova: найдено 5 файлов\n","  ✓ Обработан: DerevesnikovaD_2\n","  ✓ Обработан: DerevesnikovaD_4\n","  ✓ Обработан: DerevesnikovaD_5\n","  ✓ Обработан: DerevesnikovaD_1\n","  ✓ Обработан: DerevesnikovaD_3\n","\n","Группа acc_Nikolaenko: найдено 5 файлов\n","  ✓ Обработан: NikolaenkoD_1\n","  ✓ Обработан: NikolaenkoD_5\n","  ✓ Обработан: NikolaenkoD_4\n","  ✓ Обработан: NikolaenkoD_2\n","  ✓ Обработан: NikolaenkoD_3\n","\n","Сохранено признаков: 15 строк в /kaggle/working/signals_acc/features/acc_gait_features.xlsx\n"]}],"source":["PEAKS_SUBFOLDER = \"peaks_data\"\n","FILTERED_SUBFOLDER = \"filtered_data\"\n","TRIMMED_SUBFOLDER = \"trimmed\"\n","FEATURES_FOLDER = \"features\"\n","PLOTS_FOLDER = OUTPUT_BASE_ACC / \"спектры сигналов\"\n","PLOTS_FOLDER.mkdir(parents=True, exist_ok=True)\n","\n","def extract_signal_magnitude(df):\n","    if \"magnitude\" in df.columns:\n","        return df[\"magnitude\"].values\n","    cols_lower = {str(c).strip().lower(): c for c in df.columns}\n","    if all(k in cols_lower for k in [\"x\", \"y\", \"z\"]):\n","        return np.sqrt(df[cols_lower[\"x\"]].values**2 + df[cols_lower[\"y\"]].values**2 + df[cols_lower[\"z\"]].values**2)\n","    return df.iloc[:, 0].values\n","\n","def extract_time_and_fs(df_seg, default_fs=100.0):\n","    time_series = df_seg['time']\n","    if time_series.dtype == object:\n","        time_vals = time_series.astype(str).str.replace(',', '.').astype(float).values\n","    else:\n","        time_vals = time_series.values\n","    time_sec = time_vals - time_vals[0]\n","    time_diffs = np.diff(time_sec)\n","    fs = (1.0 / np.mean(time_diffs)) if len(time_diffs) > 0 else default_fs\n","    return time_sec, fs\n","\n","def calculate_freeze_index_from_array(signal, fs):\n","    signal = np.array(signal, dtype=float)\n","    signal_centered = signal - np.mean(signal)\n","    yf = np.abs(rfft(signal_centered))\n","    xf = rfftfreq(len(signal_centered), 1 / fs)\n","    power_spectrum = yf**2\n","    power_loco = np.sum(power_spectrum[(xf >= 0.5) & (xf <= 3.0)])\n","    power_freeze = np.sum(power_spectrum[(xf >= 3.0) & (xf <= 8.0)])\n","    fi_value = float(power_freeze / power_loco) if power_loco > 0 else 0.0\n","    return fi_value, power_loco, power_freeze, xf, power_spectrum\n","\n","def sample_entropy(signal, m=2, r=0.2):\n","    signal = np.array(signal, dtype=float)\n","    N = len(signal)\n","    if N < 10: return np.nan\n","    std_sig = np.std(signal)\n","    r_val = r * std_sig\n","    def _phi(m):\n","        x = np.array([signal[i:i+m] for i in range(N - m + 1)])\n","        C = np.sum([np.sum(np.max(np.abs(x - x_i), axis=1) <= r_val) - 1 for x_i in x])\n","        return C / (N - m + 1)\n","    phi_m = _phi(m)\n","    phi_m1 = _phi(m+1)\n","    return float(-np.log(phi_m1 / phi_m)) if phi_m1 > 0 and phi_m > 0 else np.nan\n","\n","def dominant_frequency(signal, fs):\n","    signal = np.array(signal, dtype=float)\n","    yf = np.abs(rfft(signal))\n","    xf = rfftfreq(len(signal), 1 / fs)\n","    mask = (xf >= 0.5) & (xf <= 7)\n","    xf, yf = xf[mask], yf[mask]\n","    if len(yf) == 0: return np.nan\n","    return float(xf[np.argmax(yf)])\n","\n","def compute_axis_features(signal, time):\n","    signal = np.array(signal, dtype=float)\n","    time_sec = np.array(time, dtype=float)\n","    dt = np.mean(np.diff(time_sec))\n","    fs = 1.0 / dt if dt > 0 else 1.0\n","    jerk = np.diff(signal) * fs\n","    return {\n","        \"rms\": float(np.sqrt(np.mean(signal**2))),\n","        \"std\": float(np.std(signal)),\n","        \"jerk_std\": float(np.std(jerk)),\n","        \"dominant_freq\": dominant_frequency(signal, fs)\n","    }\n","\n","def calculate_amplitude(peaks_df):\n","    peaks = peaks_df[peaks_df['type'] == 'peak'].sort_values('time').reset_index(drop=True)\n","    troughs = peaks_df[peaks_df['type'] == 'trough'].sort_values('time').reset_index(drop=True)\n","    amplitudes = []\n","    for i in range(len(troughs) - 1):\n","        trough1, trough2 = troughs.iloc[i], troughs.iloc[i + 1]\n","        mask = (peaks['time'] > trough1['time']) & (peaks['time'] < trough2['time'])\n","        peaks_between = peaks[mask]\n","        if len(peaks_between) == 0: continue\n","        max_peak = peaks_between.loc[peaks_between['amplitude'].idxmax()]\n","        amplitudes.append(abs(max_peak['amplitude'] - trough1['amplitude']))\n","    return {\n","        'amplitude_mean': float(np.mean(amplitudes)) if amplitudes else np.nan,\n","        'amplitude_std': float(np.std(amplitudes)) if len(amplitudes) > 1 else np.nan\n","    }\n","\n","def calculate_advanced_gait_metrics(filt_df, peaks_df):\n","    metrics = {\n","        \"heel_strike_peak_mean\": np.nan, \"heel_strike_peak_std\": np.nan,\n","        \"step_time_asi\": np.nan, \"amplitude_asi\": np.nan,\n","        \"cycle_symmetry_index\": np.nan, \"morphology_skewness\": np.nan, \"morphology_kurtosis\": np.nan\n","    }\n","    seg_peaks = peaks_df[peaks_df['type'] == 'peak'].sort_values('time').reset_index(drop=True)\n","    if len(seg_peaks) < 2: return metrics\n","    peak_amplitudes = seg_peaks['amplitude'].values\n","    metrics[\"heel_strike_peak_mean\"] = float(np.mean(peak_amplitudes))\n","    metrics[\"heel_strike_peak_std\"] = float(np.std(peak_amplitudes))\n","    peak_times = seg_peaks['time'].values\n","    step_intervals = np.diff(peak_times)\n","    step_intervals = step_intervals[step_intervals > 0]\n","    if len(step_intervals) >= 4:\n","        mean_a, mean_b = np.mean(step_intervals[0::2]), np.mean(step_intervals[1::2])\n","        if (mean_a + mean_b) > 0:\n","            metrics[\"step_time_asi\"] = float((2 * abs(mean_a - mean_b) / (mean_a + mean_b)) * 100)\n","    if len(peak_amplitudes) >= 4:\n","        mean_amp_a, mean_amp_b = np.mean(peak_amplitudes[0::2]), np.mean(peak_amplitudes[1::2])\n","        if (mean_amp_a + mean_amp_b) > 0:\n","            metrics[\"amplitude_asi\"] = float((2 * abs(mean_amp_a - mean_amp_b) / (mean_amp_a + mean_amp_b)) * 100)\n","    mag_arr = extract_signal_magnitude(filt_df)\n","    time_arr = filt_df['time'].values\n","    normalized_cycles = []\n","    for i in range(len(peak_times) - 2):\n","        t_start, t_end = peak_times[i], peak_times[i+2]\n","        idx = (time_arr >= t_start) & (time_arr <= t_end)\n","        cycle_data = mag_arr[idx]\n","        if len(cycle_data) > 10:\n","            f_interp = scipy.interpolate.interp1d(np.linspace(0, 1, len(cycle_data)), cycle_data, kind='cubic')\n","            normalized_cycles.append(f_interp(np.linspace(0, 1, 100)))\n","    if normalized_cycles:\n","        mean_cycle_shape = np.mean(normalized_cycles, axis=0)\n","        metrics[\"morphology_skewness\"] = float(stats.skew(mean_cycle_shape))\n","        metrics[\"morphology_kurtosis\"] = float(stats.kurtosis(mean_cycle_shape, fisher=True))\n","        half = len(mean_cycle_shape) // 2\n","        first_half, second_half = mean_cycle_shape[:half], mean_cycle_shape[half:2*half]\n","        if np.std(first_half) > 0 and np.std(second_half) > 0:\n","            metrics[\"cycle_symmetry_index\"] = float(np.corrcoef(first_half, second_half)[0, 1])\n","    return metrics\n","\n","def plot_and_save_session_spectrum(file_stem, filtered_df, save_dir):\n","    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))\n","    t_vec, fs = extract_time_and_fs(filtered_df)\n","    seg_signal = extract_signal_magnitude(filtered_df)\n","    ax1.plot(t_vec, seg_signal, color='#1f77b4', linewidth=1.0)\n","    ax1.set_title(f\"Сигнал (Magnitude): {file_stem}\")\n","    ax1.set_xlabel(\"Время, сек\")\n","    ax1.set_ylabel(\"Ускорение\")\n","    ax1.grid(True, linestyle='--', alpha=0.5)\n","    fi_val, _, _, xf, power_spectrum = calculate_freeze_index_from_array(seg_signal, fs)\n","    ax2.plot(xf, power_spectrum, color='#1f77b4', linewidth=1.2, label=f\"FI = {fi_val:.2f}\")\n","    ax2.axvspan(0.5, 3.0, color='green', alpha=0.1)\n","    ax2.axvspan(3.0, 8.0, color='red', alpha=0.1)\n","    ax2.set_xlim(0, 15)\n","    ax2.set_title(\"Спектр мощности\")\n","    ax2.set_xlabel(\"Частота, Гц\")\n","    ax2.set_ylabel(\"Мощность\")\n","    ax2.grid(True, linestyle='--', alpha=0.5)\n","    ax2.legend(loc='upper right', fontsize=8)\n","    plt.tight_layout()\n","    plt.savefig(save_dir / f\"{file_stem}_spectrum.png\", dpi=150, bbox_inches='tight')\n","    plt.close()\n","\n","raw_features = []\n","print(\"Запуск извлечения признаков акселерометра...\")\n","\n","for group in GROUPS:\n","    results_path = OUTPUT_BASE_ACC / group \n","    peaks_path = results_path / PEAKS_SUBFOLDER\n","    filtered_path = results_path / FILTERED_SUBFOLDER\n","    if not filtered_path.exists(): continue\n","    files = list(filtered_path.glob(\"*_filtered.xlsx\"))\n","    print(f\"\\nГруппа {group}: найдено {len(files)} файлов\")\n","    \n","    for file in files:\n","        base_name = file.stem.replace(\"_filtered\", \"\")\n","        peaks_file = peaks_path / f\"{base_name}_peaks.xlsx\"\n","        if not peaks_file.exists(): continue\n","        try:\n","            filt_df = pd.read_excel(file, sheet_name=\"Sheet1\")\n","            peaks_sheet_name = f\"{base_name}_magnitude\"\n","            peaks_df = pd.read_excel(peaks_file, sheet_name=peaks_sheet_name)\n","            trimmed_file = OUTPUT_BASE_ACC / group / TRIMMED_SUBFOLDER / f\"{base_name}.xlsx\"\n","            raw_df = pd.read_excel(trimmed_file, sheet_name=\"Sheet1\") if trimmed_file.exists() else filt_df\n","        except Exception:\n","            continue\n","        \n","        duration = filt_df['time'].max() - filt_df['time'].min()\n","        peaks_only = peaks_df[peaks_df['type'] == 'peak'].sort_values('time')\n","        step_count = len(peaks_only)\n","        step_time_mean, step_time_std, step_time_cv, cadence = np.nan, np.nan, np.nan, np.nan\n","        if step_count >= 2:\n","            step_times = np.diff(peaks_only['time'].values)\n","            step_times = step_times[step_times > 0]\n","            if len(step_times) > 0:\n","                step_time_mean = float(np.mean(step_times))\n","                step_time_std = float(np.std(step_times))\n","                step_time_cv = step_time_std / step_time_mean if step_time_mean > 0 else np.nan\n","                cadence = 60.0 / step_time_mean\n","                \n","        raw_signal = extract_signal_magnitude(raw_df)\n","        _, fs = extract_time_and_fs(raw_df)\n","        fi_value, _, _, _, _ = calculate_freeze_index_from_array(raw_signal, fs)\n","        mag_signal = extract_signal_magnitude(filt_df)\n","        \n","        feature_row = {\n","            \"group\": group,\n","            \"file_name\": base_name,\n","            \"duration_sec\": float(duration),\n","            \"step_count_exact\": step_count,\n","            \"step_time_mean\": step_time_mean,\n","            \"step_time_std\": step_time_std,\n","            \"step_time_cv\": float(step_time_cv),\n","            \"cadence\": float(cadence),\n","            \"freeze_index\": float(fi_value),\n","            \"sample_entropy\": sample_entropy(mag_signal)\n","        }\n","        for axis in [\"X\", \"Y\", \"Z\", \"magnitude\"]:\n","            if axis in filt_df.columns:\n","                feats = compute_axis_features(filt_df[axis].values, filt_df['time'].values)\n","                for k, v in feats.items():\n","                    feature_row[f\"{axis}_{k}\"] = v\n","        if len(peaks_df) > 0:\n","            amp_res = calculate_amplitude(peaks_df)\n","            feature_row[\"amplitude_mean\"] = amp_res['amplitude_mean']\n","            feature_row[\"amplitude_std\"] = amp_res['amplitude_std']\n","        else:\n","            feature_row[\"amplitude_mean\"] = np.nan\n","            feature_row[\"amplitude_std\"] = np.nan\n","            \n","        adv_metrics = calculate_advanced_gait_metrics(filt_df, peaks_df)\n","        for k, v in adv_metrics.items():\n","            feature_row[k] = v\n","        raw_features.append(feature_row)\n","        plot_and_save_session_spectrum(base_name, filt_df, PLOTS_FOLDER)\n","        print(f\"  ✓ Обработан: {base_name}\")\n","\n","if raw_features:\n","    df_features = pd.DataFrame(raw_features)\n","    features_folder_path = OUTPUT_BASE_ACC / FEATURES_FOLDER\n","    features_folder_path.mkdir(parents=True, exist_ok=True)\n","    save_path = features_folder_path / \"acc_gait_features.xlsx\"\n","    df_features.to_excel(save_path, index=False)\n","    print(f\"\\nСохранено признаков: {len(df_features)} строк в {save_path}\")\n","else:\n","    print(\"\\nОШИБКА: Признаки акселерометра не извлечены!\")"]},{"cell_type":"code","execution_count":12,"id":"6d9977b3","metadata":{"execution":{"iopub.execute_input":"2026-10-24T12:29:19.490467Z","iopub.status.busy":"2026-10-24T12:29:19.489836Z",