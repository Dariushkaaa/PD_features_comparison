ova_5_center.json\n","\n","\n","Обработано успешно: 39/39 файлов\n"]}],"source":["INPUT_FOLDER = \"raw_signals\"\n","CENTER_POINT_FOLDER = \"center_point\"\n","OUTPUT_FOLDER = \"trimmed\"\n","PLOTS_FOLDER = \"plots\"\n","JSON_FOLDER = \"json\"\n","\n","def load_json(json_path):\n","    if json_path.exists():\n","        with open(json_path, 'r', encoding='utf-8') as f:\n","            return json.load(f)\n","    return {}\n","\n","def save_json(json_path, data):\n","    with open(json_path, 'w', encoding='utf-8') as f:\n","        json.dump(data, f, indent=2, ensure_ascii=False)\n","\n","def find_jump_peak_by_magnitude(time, signal, search_window=15.0):\n","    search_end_idx = np.searchsorted(time, search_window)\n","    if search_end_idx > len(time):\n","        search_end_idx = len(time)\n","    initial_time = time[:search_end_idx]\n","    initial_signal = signal[:search_end_idx]\n","    peak_idx_relative = np.argmax(initial_signal)\n","    return peak_idx_relative, initial_time[peak_idx_relative], initial_signal[peak_idx_relative]\n","\n","def plot_before_after_trim(time, magnitude, start_idx, start_time, peak_idx, peak_time, save_path, title):\n","    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8))\n","    ax1.plot(time, magnitude, color='gray', linewidth=0.5, label='до обрезки')\n","    ax1.axvline(x=peak_time, color='red', linestyle='--', linewidth=1.5, label=f'пик прыжка: {peak_time:.3f} с')\n","    ax1.axvline(x=start_time, color='green', linestyle='--', linewidth=1.5, label=f'начало записи: {start_time:.3f} с')\n","    ax1.plot(time[peak_idx], magnitude[peak_idx], 'ro', markersize=8, zorder=5)\n","    ax1.plot(time[start_idx], magnitude[start_idx], 'go', markersize=8, zorder=5)\n","    ax1.set_xlim(0, min(20, time.max()))\n","    ax1.set_xlabel('Время, с')\n","    ax1.set_ylabel('Magnitude')\n","    ax1.set_title(f'{title} — ДО обрезки')\n","    ax1.legend(loc='upper right')\n","    ax1.grid(True, alpha=0.3)\n","    \n","    time_trimmed = time[start_idx:] - time[start_idx]\n","    magnitude_trimmed = magnitude[start_idx:]\n","    ax2.plot(time_trimmed, magnitude_trimmed, color='blue', linewidth=0.5)\n","    ax2.set_xlabel('Время, с (от начала записи)')\n","    ax2.set_ylabel('Magnitude')\n","    ax2.set_title(f'{title} — ПОСЛЕ обрезки ({len(magnitude_trimmed)} отсчётов)')\n","    ax2.grid(True, alpha=0.3)\n","    plt.tight_layout()\n","    save_path.parent.mkdir(parents=True, exist_ok=True)\n","    plt.savefig(save_path, dpi=150)\n","    plt.close()\n","\n","def trim_signal_to_jump(excel_path, output_path, plot_path, json_path, search_window=15.0, offset=1.5):\n","    try:\n","        df = pd.read_excel(excel_path, sheet_name=0)\n","    except Exception as e:\n","        print(f\"Ошибка чтения {excel_path.name}: {e}\")\n","        return False\n","    if df.empty or \"time\" not in df.columns:\n","        return False\n","    if \"magnitude\" not in df.columns:\n","        if all(c in df.columns for c in [\"X\", \"Y\", \"Z\"]):\n","            df[\"magnitude\"] = np.sqrt(df[\"X\"]**2 + df[\"Y\"]**2 + df[\"Z\"]**2)\n","        else:\n","            return False\n","            \n","    time = df[\"time\"].values\n","    magnitude = df[\"magnitude\"].values\n","    original_length = len(df)\n","    original_time_start = time[0]\n","    original_time_end = time[-1]\n","    \n","    peak_idx, peak_time, peak_value = find_jump_peak_by_magnitude(time, magnitude, search_window)\n","    print(f\"  Найден пик прыжка: t={peak_time:.3f} с, magnitude={peak_value:.1f} (индекс {peak_idx})\")\n","    \n","    start_time = peak_time + offset\n","    start_idx = np.searchsorted(time, start_time)\n","    print(f\"  Начало записи: t={start_time:.3f} с (индекс {start_idx})\")\n","    \n","    plot_before_after_trim(time, magnitude, start_idx, start_time, peak_idx, peak_time, plot_path, excel_path.stem)\n","    \n","    df_trimmed = df.iloc[start_idx:].reset_index(drop=True)\n","    df_trimmed['time'] = df_trimmed['time'] - df_trimmed['time'].iloc[0]\n","    df_trimmed.to_excel(output_path, sheet_name=\"Sheet1\", index=False)\n","    \n","    trimmed_length = len(df_trimmed)\n","    trimmed_time_end = df_trimmed['time'].iloc[-1]\n","    \n","    json_data = load_json(json_path)\n","    json_data['source_file'] = excel_path.name\n","    json_data['trim'] = {\n","        'peak_time_original': float(peak_time),\n","        'peak_value': float(peak_value),\n","        'peak_index': int(peak_idx),\n","        'start_time_original': float(start_time),\n","        'start_index': int(start_idx),\n","        'offset_seconds': float(offset),\n","        'original_rows': int(original_length),\n","        'trimmed_rows': int(trimmed_length),\n","        'removed_rows': int(original_length - trimmed_length),\n","        'time_offset_seconds': float(start_time - original_time_start),\n","        'original_time_range': [float(original_time_start), float(original_time_end)],\n","        'trimmed_time_range': [0.0, float(trimmed_time_end)]\n","    }\n","    save_json(json_path, json_data)\n","    print(f\"  Сохранено: {output_path.name} ({trimmed_length} строк, было {original_length})\")\n","    print(f\"  JSON: {json_path.name}\\n\")\n","    return True\n","\n","total_success = 0\n","total_files = 0\n","\n","for group in GROUPS:\n","    input_path = OUTPUT_BASE / group / INPUT_FOLDER\n","    center_point_path = OUTPUT_BASE / group / CENTER_POINT_FOLDER\n","    output_path = OUTPUT_BASE / group / OUTPUT_FOLDER\n","    plots_path = OUTPUT_BASE / group / PLOTS_FOLDER\n","    json_path = OUTPUT_BASE / group / JSON_FOLDER\n","    \n","    if not input_path.exists(): continue\n","    output_path.mkdir(parents=True, exist_ok=True)\n","    plots_path.mkdir(parents=True, exist_ok=True)\n","    json_path.mkdir(parents=True, exist_ok=True)\n","    \n","    xlsx_files = [f for f in input_path.glob(\"*.xlsx\") if not f.name.startswith(\"~$\")]\n","    print(f\"Группа {group}: {len(xlsx_files)} файлов в raw_signals\")\n","    \n","    for excel_path in sorted(xlsx_files):\n","        if trim_signal_to_jump(excel_path, output_path / excel_path.name, plots_path / f\"{excel_path.stem}.png\", json_path / f\"{excel_path.stem}.json\", SEARCH_WINDOW, OFFSET_AFTER_JUMP):\n","            total_success += 1\n","        total_files += 1\n","        \n","    if center_point_path.exists():\n","        center_xlsx_files = [f for f in center_point_path.glob(\"*.xlsx\") if not f.name.startswith(\"~$\")]\n","        print(f\"Обработка центральных точек группы {group}: {len(center_xlsx_files)} файлов\")\n","        for excel_path in sorted(center_xlsx_files):\n","            if trim_signal_to_jump(excel_path, output_path / excel_path.name, plots_path / f\"{excel_path.stem}.png\", json_path / f\"{excel_path.stem}.json\", SEARCH_WINDOW, OFFSET_AFTER_JUMP):\n","                total_success += 1\n","            total_files += 1\n","\n","print(f\"\\nОбработано успешно: {total_success}/{total_files} файлов\")"]},{"cell_type":"markdown","id":"96be03bf","metadata":{"papermill":{"duration":0.007869,"end_time":"2026-10-24T12:05:37.329792+00:00","exception":false,"start_time":"2026-10-24T12:05:37.321923+00:00","status":"completed"},"tags":[]},"source":["## ШАГ 4: Фильтрация, нормализация и поиск экстремумов"]},{"cell_type":"code","execution_count":5,"id":"38c9a5ec","metadata":{"execution":{"iopub.execute_input":"2026-10-24T12:05:37.348232Z","iopub.status.busy":"2026-10-24T12:05:37.347488Z","iopub.status.idle":"2026-10-24T12:08:13.3567Z","shell.execute_reply":"2026-10-24T12:08:13.35546Z"},"papermill":{"duration":156.021161,"end_time":"2026-10-24T12:08:13.358901+00:00","exception":false,"start_time":"2026-10-24T12:05:37.33774+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Группа ampl_Afonina / trimmed — файлов: 15\n","  Обработан: Afonina_1_LASI\n","  Обработан: Afonina_1_RASI\n","  Обработан: Afonina_1_center\n","  Обработан: Afonina_2_LASI\n","  Обработан: 