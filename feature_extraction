nko_3_LASI.xlsx (11956 строк)\n","    Nikolaenko_3_RASI.xlsx (11956 строк)\n","    Nikolaenko_3_center.xlsx (11956 строк)\n","  Готово\n","\n","  Nikolaenko_4.xlsx\n","    Nikolaenko_4_LASI.xlsx (12736 строк)\n","    Nikolaenko_4_RASI.xlsx (12736 строк)\n","    Nikolaenko_4_center.xlsx (12736 строк)\n","  Готово\n","\n","  Nikolaenko_5.xlsx\n","    Nikolaenko_5_LASI.xlsx (13510 строк)\n","    Nikolaenko_5_RASI.xlsx (13510 строк)\n","    Nikolaenko_5_center.xlsx (13510 строк)\n","  Готово\n","\n","ampl_Derevesnikova → Derevesnikova Darya Alexandrovna_2\n","Исходные: /kaggle/input/datasets/daryushka/signals-comparison/signals/vicon/ampl_Derevesnikova/ampl\n","Результаты: /kaggle/working/signals_vicon/ampl_Derevesnikova/raw_signals\n","Файлов: 5\n","\n","  Derevesnikova_1.xlsx\n","    Derevesnikova_1_LASI.xlsx (13378 строк)\n","    Derevesnikova_1_RASI.xlsx (13378 строк)\n","    Derevesnikova_1_center.xlsx (13378 строк)\n","  Готово\n","\n","  Derevesnikova_2.xlsx\n","    Предупреждение: отсутствуют данные LASI или RASI для вычисления центра\n","  Готово\n","\n","  Derevesnikova_3.xlsx\n","    Derevesnikova_3_LASI.xlsx (12850 строк)\n","    Derevesnikova_3_RASI.xlsx (12850 строк)\n","    Derevesnikova_3_center.xlsx (12850 строк)\n","  Готово\n","\n","  Derevesnikova_4.xlsx\n","    Предупреждение: отсутствуют данные LASI или RASI для вычисления центра\n","  Готово\n","\n","  Derevesnikova_5.xlsx\n","    Derevesnikova_5_LASI.xlsx (13248 строк)\n","    Derevesnikova_5_RASI.xlsx (13248 строк)\n","    Derevesnikova_5_center.xlsx (13248 строк)\n","  Готово\n","\n","Обработано файлов: 15\n","Сохранено таблиц маркеров: 26\n","Сохранено таблиц центральной точки: 13\n"]}],"source":["def read_vicon_file(input_path, subject_full_name, marker_types, fs):\n","    df_raw = pd.read_excel(input_path, header=None)\n","    \n","    header_idx = None\n","    for i in range(min(10, len(df_raw))):\n","        row_vals = df_raw.iloc[i].astype(str).str.lower().values\n","        if 'frame' in row_vals and 'sub frame' in row_vals:\n","            header_idx = i\n","            break\n","            \n","    marker_idx = None\n","    for i in range(header_idx):\n","        row_str = ' '.join(df_raw.iloc[i].astype(str).values)\n","        if ':' in row_str:\n","            marker_idx = i\n","            break\n","            \n","    if marker_idx is None:\n","        marker_idx = max(0, header_idx - 2)\n","        \n","    markers = df_raw.iloc[marker_idx, 2:].ffill().values\n","    markers = [str(m).strip() for m in markers]\n","    \n","    marker_data = {}\n","    for mtype in marker_types:\n","        full_marker = f\"{subject_full_name}:{mtype}\"\n","        for idx, m in enumerate(markers):\n","            if m == full_marker:\n","                marker_data[mtype] = [idx, idx + 1, idx + 2]\n","                break\n","                \n","    data_start_idx = header_idx + 2\n","    if data_start_idx >= len(df_raw) or pd.isna(df_raw.iloc[data_start_idx, 0]):\n","        data_start_idx = header_idx + 1\n","        \n","    result = {}\n","    for mtype, indices in marker_data.items():\n","        data_rows = []\n","        for row_idx in range(data_start_idx, len(df_raw)):\n","            frame = df_raw.iloc[row_idx, 0]\n","            sub_frame = df_raw.iloc[row_idx, 1]\n","            if pd.isna(frame):\n","                break\n","            time_val = (float(frame) + float(sub_frame)) / fs\n","            x_raw = df_raw.iloc[row_idx, indices[0] + 2]\n","            y_raw = df_raw.iloc[row_idx, indices[1] + 2]\n","            z_raw = df_raw.iloc[row_idx, indices[2] + 2]\n","            data_rows.append([time_val, x_raw, y_raw, z_raw])\n","            \n","        df_temp = pd.DataFrame(data_rows, columns=['time', 'X', 'Y', 'Z'])\n","        for col in ['X', 'Y', 'Z']:\n","            df_temp[col] = pd.to_numeric(df_temp[col].astype(str).str.replace(',', '.'), errors='coerce')\n","            \n","        df_temp = df_temp.interpolate(method='linear', limit_direction='both').bfill().ffill().fillna(0.0)\n","        df_temp['magnitude'] = np.sqrt(df_temp['X']**2 + df_temp['Y']**2 + df_temp['Z']**2)\n","        df_temp['yaw'] = np.degrees(np.arctan2(df_temp['Y'], df_temp['X']))\n","        result[mtype] = df_temp[['time', 'X', 'Y', 'Z', 'magnitude', 'yaw']]\n","        \n","    return result\n","\n","def calculate_center_point(df_lasi, df_rasi):\n","    min_len = min(len(df_lasi), len(df_rasi))\n","    lasi = df_lasi.iloc[:min_len].reset_index(drop=True)\n","    rasi = df_rasi.iloc[:min_len].reset_index(drop=True)\n","    \n","    center_df = pd.DataFrame({\n","        'time': lasi['time'],\n","        'X': (lasi['X'] + rasi['X']) / 2,\n","        'Y': (lasi['Y'] + rasi['Y']) / 2,\n","        'Z': (lasi['Z'] + rasi['Z']) / 2\n","    })\n","    \n","    for col in ['X', 'Y', 'Z']:\n","        center_df[col] = center_df[col].interpolate(method='linear', limit_direction='both').bfill().ffill().fillna(0.0)\n","        \n","    center_df['magnitude'] = np.sqrt(center_df['X']**2 + center_df['Y']**2 + center_df['Z']**2)\n","    center_df['yaw'] = np.degrees(np.arctan2(center_df['Y'], center_df['X']))\n","    return center_df[['time', 'X', 'Y', 'Z', 'magnitude', 'yaw']]\n","\n","def save_to_excel_formatted(df, output_path):\n","    writer = pd.ExcelWriter(output_path, engine='xlsxwriter')\n","    df.to_excel(writer, sheet_name='Sheet1', index=False)\n","    workbook = writer.book\n","    worksheet = writer.sheets['Sheet1']\n","    number_format = workbook.add_format({'num_format': '0.0000000'})\n","    for col_num in range(len(df.columns)):\n","        worksheet.set_column(col_num, col_num, 18, number_format)\n","    writer.close()\n","\n","total_files = 0\n","total_saved = 0\n","total_center_saved = 0\n","\n","for subject_folder, subject_full_name in SUBJECTS.items():\n","    ampl_folder = BASE_PATH / subject_folder / 'ampl'\n","    raw_signals_folder = OUTPUT_BASE / subject_folder / 'raw_signals'\n","    center_point_folder = OUTPUT_BASE / subject_folder / 'center_point'\n","    \n","    if not ampl_folder.exists():\n","        print(f\"Папка не найдена: {ampl_folder}\")\n","        continue\n","        \n","    raw_signals_folder.mkdir(parents=True, exist_ok=True)\n","    center_point_folder.mkdir(parents=True, exist_ok=True)\n","    xlsx_files = sorted(glob.glob(str(ampl_folder / '*.xlsx')))\n","    \n","    if not xlsx_files:\n","        print(f\"Файлы не найдены в: {ampl_folder}\")\n","        continue\n","        \n","    print(f\"{subject_folder} → {subject_full_name}\")\n","    print(f\"Исходные: {ampl_folder}\")\n","    print(f\"Результаты: {raw_signals_folder}\")\n","    print(f\"Файлов: {len(xlsx_files)}\\n\")\n","    \n","    for input_file in xlsx_files:\n","        filename = os.path.basename(input_file)\n","        filename_no_ext = os.path.splitext(filename)[0]\n","        print(f\"  {filename}\")\n","        try:\n","            marker_dfs = read_vicon_file(input_file, subject_full_name, MARKER_TYPES, FS)\n","            if marker_dfs is None:\n","                print(\"  Пропущен\\n\")\n","                continue\n","            for mtype, df_marker in marker_dfs.items():\n","                output_file = raw_signals_folder / f\"{filename_no_ext}_{mtype}.xlsx\"\n","                save_to_excel_formatted(df_marker, output_file)\n","                print(f\"    {filename_no_ext}_{mtype}.xlsx ({df_marker.shape[0]} строк)\")\n","                total_saved += 1\n","            if 'LASI' in marker_dfs and 'RASI' in marker_dfs:\n","                center_df = calculate_center_point(marker_dfs['LASI'], marker_dfs['RASI'])\n","                center_output_file = center_point_folder / f\"{filename_no_ext}_center.xlsx\"\n","                save_to_excel_formatted(center_df, center_output_file)\n","                print(f\"    {filename_no_ext}_center.xlsx ({center_df.shape[0]} строк)\")\n","                total_center_saved += 1\n","            else:\n","         