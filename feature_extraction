inaA\", \"Afonina\"))\n","\n","def get_vicon_trimmed_duration(group: str, acc_basename: str) -> float:\n","    vicon_group = ACC_TO_VICON_GROUP.get(group, group)\n","    vicon_base = get_vicon_basename(acc_basename)\n","    vicon_trimmed_dir = BASE_PATH_VICON / vicon_group / \"trimmed\"\n","    matching_files = list(vicon_trimmed_dir.glob(f\"{vicon_base}*.xlsx\"))\n","    if not matching_files:\n","        return None\n","    df_vicon = pd.read_excel(matching_files[0], sheet_name=\"Sheet1\")\n","    if \"time\" in df_vicon.columns:\n","        return float(df_vicon[\"time\"].max())\n","    return None\n","\n","def find_jump_peak_accelerometer(time, signal, fs=100, min_prominence=5.0, min_amplitude=20.0):\n","    peaks, _ = find_peaks(signal, distance=int(fs * 0.5), prominence=min_prominence)\n","    if len(peaks) == 0:\n","        peak_idx = np.argmax(signal)\n","        return peak_idx, time[peak_idx], signal[peak_idx]\n","    peak_amplitudes = signal[peaks]\n","    valid_mask = peak_amplitudes >= min_amplitude\n","    valid_peaks = peaks[valid_mask]\n","    valid_amplitudes = peak_amplitudes[valid_mask]\n","    if len(valid_peaks) == 0:\n","        peak_idx = np.argmax(signal)\n","        return peak_idx, time[peak_idx], signal[peak_idx]\n","    sorted_indices = np.argsort(valid_amplitudes)[::-1]\n","    return valid_peaks[sorted_indices[0]], time[valid_peaks[sorted_indices[0]]], signal[valid_peaks[sorted_indices[0]]]\n","\n","def plot_before_after_trim(time, magnitude, start_idx, start_time, peak_idx, peak_time, save_path, title, target_duration=None):\n","    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8))\n","    ax1.plot(time, magnitude, color='gray', linewidth=0.5, label='до обрезки')\n","    ax1.axvline(x=peak_time, color='red', linestyle='--', linewidth=1.5, label=f'пик: {peak_time:.3f} с')\n","    ax1.axvline(x=start_time, color='green', linestyle='--', linewidth=1.0, alpha=0.5, label=f'начало: {start_time:.3f} с')\n","    if target_duration is not None:\n","        ax1.axvline(x=start_time + target_duration, color='orange', linestyle=':', linewidth=1.5, label=f'конец Vicon: {start_time + target_duration:.3f} с')\n","    ax1.plot(time[peak_idx], magnitude[peak_idx], 'ro', markersize=10, zorder=5)\n","    ax1.plot(time[start_idx], magnitude[start_idx], 'go', markersize=8, zorder=5)\n","    ax1.set_xlim(0, time.max())\n","    ax1.set_xlabel('Время, с')\n","    ax1.set_ylabel('Magnitude')\n","    ax1.set_title(f'{title} — ДО обрезки')\n","    ax1.legend(loc='upper right', fontsize=8)\n","    ax1.grid(True, alpha=0.3)\n","    \n","    time_trimmed = time[start_idx:] - time[start_idx]\n","    magnitude_trimmed = magnitude[start_idx:]\n","    ax2.plot(time_trimmed, magnitude_trimmed, color='blue', linewidth=0.5)\n","    ax2.set_xlabel('Время, с')\n","    ax2.set_ylabel('Magnitude')\n","    ax2.set_title(f'{title} — ПОСЛЕ обрезки')\n","    ax2.grid(True, alpha=0.3)\n","    plt.tight_layout()\n","    save_path.parent.mkdir(parents=True, exist_ok=True)\n","    plt.savefig(save_path, dpi=150)\n","    plt.close()\n","\n","def trim_signal_to_jump(excel_path, output_path, plot_path, json_path, group, search_window=15.0, offset=1.5):\n","    try:\n","        df = pd.read_excel(excel_path, sheet_name=0)\n","    except Exception as e:\n","        print(f\"Ошибка чтения {excel_path.name}: {e}\")\n","        return False\n","    if df.empty or \"time\" not in df.columns:\n","        return False\n","    if \"magnitude\" not in df.columns:\n","        if all(c in df.columns for c in [\"X\", \"Y\", \"Z\"]):\n","            df[\"magnitude\"] = np.sqrt(df[\"X\"]**2 + df[\"Y\"]**2 + df[\"Z\"]**2)\n","        else:\n","            return False\n","            \n","    time = df[\"time\"].values\n","    magnitude = df[\"magnitude\"].values\n","    original_length = len(df)\n","    original_time_start = time[0]\n","    original_time_end = time[-1]\n","    \n","    peak_idx, peak_time, peak_value = find_jump_peak_accelerometer(time, magnitude, fs=FS)\n","    print(f\"  Найден пик прыжка: t={peak_time:.3f} с, magnitude={peak_value:.1f} (индекс {peak_idx})\")\n","    \n","    start_time = peak_time + offset\n","    start_idx = np.searchsorted(time, start_time)\n","    print(f\"  Начало записи: t={start_time:.3f} с (индекс {start_idx})\")\n","    \n","    df_trimmed = df.iloc[start_idx:].reset_index(drop=True)\n","    df_trimmed['time'] = df_trimmed['time'] - df_trimmed['time'].iloc[0]\n","    duration_after_start_trim = float(df_trimmed['time'].max())\n","    \n","    target_duration = get_vicon_trimmed_duration(group, excel_path.stem)\n","    tail_trim_info = None\n","    if target_duration is not None:\n","        mask = df_trimmed['time'] <= (target_duration + 0.01)\n","        rows_before_tail = len(df_trimmed)\n","        df_trimmed = df_trimmed[mask].reset_index(drop=True)\n","        final_duration = float(df_trimmed['time'].max())\n","        removed_seconds = duration_after_start_trim - final_duration\n","        removed_rows = rows_before_tail - len(df_trimmed)\n","        tail_trim_info = {\n","            'target_duration_from_vicon': float(target_duration),\n","            'final_duration': float(final_duration),\n","            'removed_seconds': float(removed_seconds),\n","            'removed_rows': int(removed_rows)\n","        }\n","        print(f\"  Обрезка конца: удалено {removed_seconds:.3f} с ({removed_rows} строк).\")\n","    else:\n","        final_duration = duration_after_start_trim\n","        print(f\"  Обрезка конца пропущена (не найдена длительность Vicon).\")\n","        \n","    plot_before_after_trim(time, magnitude, start_idx, start_time, peak_idx, peak_time, plot_path, excel_path.stem, target_duration)\n","    df_trimmed.to_excel(output_path, sheet_name=\"Sheet1\", index=False)\n","    \n","    json_data = load_json(json_path)\n","    json_data['source_file'] = excel_path.name\n","    json_data['trim_start'] = {\n","        'peak_time_original': float(peak_time),\n","        'peak_value': float(peak_value),\n","        'start_time_original': float(start_time),\n","        'original_time_range': [float(original_time_start), float(original_time_end)]\n","    }\n","    if tail_trim_info:\n","        json_data['trim_end'] = tail_trim_info\n","    json_data['final_stats'] = {\n","        'original_rows': int(original_length),\n","        'final_rows': int(len(df_trimmed)),\n","        'final_time_range': [0.0, float(final_duration)]\n","    }\n","    save_json(json_path, json_data)\n","    print(f\"  ✓ Сохранено: {output_path.name} ({len(df_trimmed)} строк, было {original_length})\\n\")\n","    return True\n","\n","total_files = 0\n","total_success = 0\n","\n","for group in GROUPS:\n","    input_path = OUTPUT_BASE_ACC / group / INPUT_FOLDER\n","    output_path = OUTPUT_BASE_ACC / group / OUTPUT_FOLDER\n","    plots_path = OUTPUT_BASE_ACC / group / PLOTS_FOLDER\n","    json_path = OUTPUT_BASE_ACC / group / JSON_FOLDER\n","    if not input_path.exists(): continue\n","    output_path.mkdir(parents=True, exist_ok=True)\n","    plots_path.mkdir(parents=True, exist_ok=True)\n","    json_path.mkdir(parents=True, exist_ok=True)\n","    \n","    xlsx_files = [f for f in input_path.glob(\"*.xlsx\") if not f.name.startswith(\"~$\")]\n","    print(f\"Группа {group}: {len(xlsx_files)} файлов\")\n","    for excel_path in sorted(xlsx_files):\n","        if trim_signal_to_jump(excel_path, output_path / excel_path.name, plots_path / f\"{excel_path.stem}.png\", json_path / f\"{excel_path.stem}.json\", group, SEARCH_WINDOW, OFFSET_AFTER_JUMP):\n","            total_success += 1\n","        total_files += 1\n","\n","print(f\"Обрезка акселерометра завершена: {total_success}/{total_files} файлов\")"]},{"cell_type":"markdown","id":"4e4873ec","metadata":{"papermill":{"duration":0.012766,"end_time":"2026-10-24T12:22:29.341298+00:00","exception":false,"start_time":"2026-10-24T12:22:29.328532+00:00","status":"completed"},"tags":[]},"source":["## ШАГ 4: Филь